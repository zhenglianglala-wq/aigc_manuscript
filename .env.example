# Template only: never put a real API key in this tracked file.
# The implementation will default to offline fixtures until explicitly configured.
# Backend-only secret. Keep empty for fixture mode.
LLM_API_KEY=
# Example format: https://your-compatible-service/v1 (no credentials in URL).
LLM_BASE_URL=
# Exact model identifier provided by your service.
LLM_MODEL=
# Empty defaults to fixture; real protocol: openai-compatible.
LLM_MODE=
# Empty defaults to project data/; never commit runtime contents.
DATA_DIR=
# Empty disables paid calls. true ALSO requires project approval in the app.
PAID_CALLS_ENABLED=

# Photo generation credentials and switch are independent from text/video.
# Keep all values empty to use labelled offline placeholders.
IMAGE_API_KEY=
# Example format: https://your-compatible-service/v1
IMAGE_BASE_URL=
IMAGE_MODEL=
# Empty defaults to fixture; real protocol: openai-compatible (Base64 response).
IMAGE_MODE=
# true also requires a photo project approval specifically for image generation.
PAID_IMAGE_CALLS_ENABLED=
